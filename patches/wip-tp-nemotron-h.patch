             if (src_ss[0].axis == GGML_BACKEND_SPLIT_AXIS_0) {
@@ -970,7 +1003,9 @@ static struct ggml_backend_meta_split_state ggml_backend_meta_get_split_state(
             case GGML_OP_SSM_CONV: {
