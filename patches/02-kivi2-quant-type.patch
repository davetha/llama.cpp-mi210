+// Per-group min-max asymmetric quant, group_size=32, 4 levels {0,1,2,3}.
+// Per block: d(fp16 scale) + m(fp16 min) + 2-bit indices packed 4-per-byte (8 bytes)
+// = 12 bytes per 32 values = 3.0 bits/value -> 5.3x compression vs fp16
+#define QK_KIVI2 32
+typedef struct {
+    ggml_half d;                     //  2 bytes: scale (delta) = (max-min)/3
+    ggml_half m;                     //  2 bytes: min
+    uint8_t   qs[QK_KIVI2 / 4];      //  8 bytes: 2-bit indices (4 per byte)
+} block_kivi2;                       // 12 bytes total
+static_assert(sizeof(block_kivi2) == 12, "wrong kivi2 block size");
