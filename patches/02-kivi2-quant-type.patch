+size_t quantize_kivi2(const float * GGML_RESTRICT src, void * GGML_RESTRICT dst, int64_t nrows, int64_t n_per_row, const float * imatrix) {
+    GGML_UNUSED(imatrix);
+    assert(n_per_row % QK_KIVI2 == 0);
+    size_t row_size = (n_per_row / QK_KIVI2) * sizeof(block_kivi2);
+    for (int64_t row = 0; row < nrows; row++) {
+        quantize_row_kivi2_ref(
+            src + row * n_per_row,
+            (block_kivi2 *)((char *)dst + row * row_size),
+            n_per_row
+        );
+    }
+    return nrows * row_size;
+}
