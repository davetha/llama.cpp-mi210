+// ===================== KIVI-2: 2-bit asymmetric KV cache quantization =====================
+// KIVI (arXiv 2402.02750): per-group (group_size=32) asymmetric min-max 2-bit quant.
+// 4 levels {0,1,2,3}; reconstructed value = idx*scale + min.
+// Per block: d(fp16) + m(fp16) + 2-bit indices packed 4-per-byte (8 bytes) = 12 bytes/32 vals
+// = 3.0 bits/value -> 5.3x compression vs fp16
+
+void quantize_row_kivi2_ref(const float * GGML_RESTRICT x, block_kivi2 * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_KIVI2;
+
+    assert(k % qk == 0);
+
+    const int nb = k / qk;
+
+    for (int i = 0; i < nb; i++) {
+        float min = FLT_MAX;
+        float max = -FLT_MAX;
+
+        for (int j = 0; j < qk; j++) {
+            const float v = x[i*qk + j];
+            if (v < min) min = v;
+            if (v > max) max = v;
+        }
+
+        const float d  = (max - min) / ((1 << 2) - 1);  // 4 levels -> divide by 3
+        const float id = d ? 1.0f/d : 0.0f;
+
+        y[i].d = GGML_FP32_TO_FP16(d);
+        y[i].m = GGML_FP32_TO_FP16(min);
+
+        for (int j = 0; j < qk; j += 4) {
+            uint8_t byte = 0;
+            for (int b = 0; b < 4; b++) {
+                // xv >= 0 guaranteed since x[j+b] >= min and id >= 0
+                const float xv = (x[i*qk + j + b] - min) * id;
+                uint8_t xi = (uint8_t)(xv + 0.5f);
+                if (xi > 3) xi = 3;  // clamp to [0,3] (handles fp rounding of max)
+                byte |= (uint8_t)(xi & 0x3) << (b * 2);
+            }
+            y[i].qs[j/4] = byte;
+        }
+    }
+}
+
+void dequantize_row_kivi2(const block_kivi2 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    const int qk = QK_KIVI2;
+
+    assert(k % qk == 0);
+
+    const int nb = k / qk;
+
+    for (int i = 0; i < nb; i++) {
+        const float d = GGML_FP16_TO_FP32(x[i].d);
+        const float m = GGML_FP16_TO_FP32(x[i].m);
+
+        for (int j = 0; j < qk; j++) {
+            const uint8_t xi = (x[i].qs[j/4] >> ((j%4)*2)) & 0x3;
+            y[i*qk + j] = xi*d + m;
+        }
+    }
+}
