+// MI210_NEU_PADDED: smallest power of 2 >= n (n >= 1), evaluated at compile time.
+static constexpr int mm_ids_next_pow2(int n) {
+    int p = 1;
+    while (p < n) {
+        p *= 2;
+    }
+    return p;
+}
